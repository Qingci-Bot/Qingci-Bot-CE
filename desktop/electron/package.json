{
  "name": "qingci-bot-ce-desktop",
  "version": "1.17.3",
  "description": "Qingci-Bot CE Electron 桌面壳（Electron + Python 混合架构）",
  "main": "src/main.js",
  "author": "Qingci-Bot",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:win:dir": "electron-builder --win --dir",
    "build:linux:dir": "electron-builder --linux --dir"
  },
  "build": {
    "appId": "com.qingcibot.ce",
    "productName": "Qingci-Bot CE",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/qingci-bot-ce",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Qingci-Bot-CE-${version}-Setup-${arch}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Network",
      "artifactName": "Qingci-Bot-CE-${version}-${os}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
