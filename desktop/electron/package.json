{
  "name": "qingci-bot-ce-desktop",
  "version": "1.21.0",
  "description": "Qingci-Bot CE Electron 桌面壳（Electron + Python 混合架构）",
  "main": "src/main.js",
  "homepage": "https://github.com/Qingci-Bot/Qingci-Bot-CE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qingci-Bot/Qingci-Bot-CE.git"
  },
  "author": "Qingci-Bot <https://github.com/Qingci-Bot>",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux deb rpm",
    "build:win:dir": "electron-builder --win --dir",
    "build:linux:dir": "electron-builder --linux --dir"
  },
  "build": {
    "appId": "com.qingcibot.ce",
    "productName": "Qingci-Bot CE",
    "publish": null,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/backend.zip",
        "to": "backend.zip"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Qingci-Bot-CE-${version}-Setup-${arch}.exe",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Network",
      "synopsis": "Multi-platform bot framework",
      "description": "Qingci-Bot CE desktop application: Electron shell with embedded Python backend, providing Web UI for bot / LLM configuration and monitoring.",
      "maintainer": "Qingci-Bot <https://github.com/Qingci-Bot>",
      "vendor": "Qingci-Bot",
      "artifactName": "Qingci-Bot-CE-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ],
      "recommends": [
        "libayatana-appindicator3-1"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-atk",
        "libsecret"
      ],
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron": true
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  }
}
